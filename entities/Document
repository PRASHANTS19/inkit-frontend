{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title or name"
    },
    "case_id": {
      "type": "string",
      "description": "Associated case ID"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "petition",
        "affidavit",
        "evidence",
        "order",
        "judgment",
        "notice",
        "application",
        "reply",
        "contract",
        "agreement"
      ],
      "description": "Type of legal document"
    },
    "file_url": {
      "type": "string",
      "description": "URL to the uploaded document file"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "file_type": {
      "type": "string",
      "description": "File format (PDF, DOC, etc.)"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date when document was uploaded"
    },
    "uploaded_by": {
      "type": "string",
      "description": "User who uploaded the document"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the document"
    },
    "is_confidential": {
      "type": "boolean",
      "default": false,
      "description": "Whether document is confidential"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document tags for organization"
    },
    "extracted_text": {
      "type": "string",
      "description": "Full text content extracted from the document for AI processing"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of document content"
    },
    "firm_id": {
      "type": "string",
      "description": "ID of the associated firm"
    }
  },
  "required": [
    "title",
    "case_id",
    "document_type",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "account_type": {
              "$in": [
                "independent_advocate",
                "law_firm_admin"
              ]
            }
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "uploaded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "account_type": {
              "$in": [
                "independent_advocate",
                "law_firm_admin"
              ]
            }
          }
        }
      ]
    }
  }
}